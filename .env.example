# PostgreSQL 접속 정보 — 실제 값은 .env에 복사해 사용 (git 금지)
POSTGRES_USER=banblit
POSTGRES_PASSWORD=banblit-dev-password
POSTGRES_DB=banblit

# 자동 배정 서비스 — 켜고 끄기와 확인 간격(초). 비밀값이 아니다.
# 주석을 풀면 배포·개발 양쪽 기본값을 모두 덮는다. 그대로 두면 docker-compose.yml 이
# 배포 기본값(true / 60), docker-compose.override.yml 이 개발 기본값(false / 10)을 쓴다.
#AUTO_ASSIGN_ENABLED=true
#AUTO_ASSIGN_INTERVAL_SECONDS=60

# 게시판 첨부파일을 두는 컨테이너 안 경로. 비밀값이 아니다.
# 주석을 풀지 않으면 docker-compose.yml 이 이 기본값을 쓰고, 같은 경로에
# banblit-attachments 볼륨이 붙는다. 바꾸면 두 자리가 함께 바뀐다.
#ATTACHMENT_DIR=/var/lib/banblit/attachments

# 메일 보내기 — 비밀번호 재설정 링크와 아이디 안내가 이 계정으로 나간다.
# SMTP_HOST 를 비워 두면 실제로 보내지 않고 기록(INFO)만 남긴다. 개발과 검사는
# 그대로 이 상태로 돌린다 — 검사가 메일을 보내는 일이 없다.
# Gmail 은 2단계 인증을 켠 계정에서 만든 "앱 비밀번호" 16자리를 SMTP_PASSWORD 에 넣는다.
# 계정을 받으면 아래 네 줄의 주석을 풀고 .env 에 실제 값을 적는다(git 에 올리지 않는다).
# 컨테이너로 넘기는 자리는 docker-compose.yml 의 api 서비스에 이미 적혀 있다 — .env 만 채우면 된다.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=보내는-계정@gmail.com
#SMTP_PASSWORD=앱-비밀번호-16자리
# 받는 사람에게 보이는 주소. 비워 두면 SMTP_USER 를 그대로 쓴다.
#MAIL_FROM=보내는-계정@gmail.com

# 메일에 담을 재설정 링크의 앞부분. 비워 두면 http://localhost:5173 을 쓴다.
#APP_ORIGIN=https://banblit.example.com
