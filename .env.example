# 이 파일은 견본입니다. `cp .env.example .env` 로 복사한 뒤 .env 를 고치십시오.
# .env 는 git 에 올라가지 않습니다. 비밀번호와 앱 비밀번호는 .env 에만 적으십시오.
#
# 값 앞뒤에 따옴표를 붙이지 마십시오. 줄 끝에 공백을 남기지 마십시오.
# 그런 것이 값에 그대로 섞여 들어가 접속이 조용히 실패합니다.
#
# 고친 뒤에는 반드시 다시 띄워야 적용됩니다:  banblit restart api


# ══════════════════════════════════════════════════════════════════════════
# 1. 데이터베이스 — 개발은 이대로, 배포는 비밀번호만 바꿉니다
# ══════════════════════════════════════════════════════════════════════════

# 데이터베이스에 접속할 계정 이름. 바꿀 이유가 없습니다.
POSTGRES_USER=banblit

# 데이터베이스 비밀번호.
#   개발  이대로 두십시오. 이 PC 밖으로 나가지 않습니다.
#   배포  반드시 바꾸십시오. 이 값 그대로면 banblit.sh 가 뜨기 전에 막습니다.
#         만들어 쓰려면 서버에서:  openssl rand -base64 24
POSTGRES_PASSWORD=banblit-dev-password

# 데이터베이스 이름. 바꿀 이유가 없습니다.
POSTGRES_DB=banblit


# ══════════════════════════════════════════════════════════════════════════
# 2. 서비스 주소 — 배포에서 반드시 채웁니다
# ══════════════════════════════════════════════════════════════════════════

# 사람들이 브라우저에 칠 주소입니다. 앞의 https:// 는 빼고 이름만 적습니다.
#
# 이 이름으로 인증서를 자동으로 받습니다. 그러려면 이 이름이 실제로 이 서버를
# 가리키고 있어야 합니다. DNS 에 A 레코드로 서버 아이피를 걸어 두십시오.
#
# Cloudflare 를 쓴다면 이 레코드의 프록시를 끄십시오(회색 구름, DNS only).
# 주황 구름인 채로 두면 인증서 발급이 막힙니다. 굳이 켜려면 SSL 모드를
# Full (strict) 로 두어야 합니다.
#
# 비워 두면 배포가 뜨기 전에 멈춥니다. 개발에서는 비워 두어도 됩니다.
#BANBLIT_DOMAIN=insixstrings.banblit.com

# 메일에 담기는 링크의 앞부분입니다. 비밀번호 재설정 링크가 이 주소로 만들어집니다.
# 배포에서는 위 도메인에 https:// 를 붙여 적으십시오. 안 적으면 링크가
# http://localhost:5173 을 가리켜, 받는 사람이 눌러도 열리지 않습니다.
#APP_ORIGIN=https://insixstrings.banblit.com


# ══════════════════════════════════════════════════════════════════════════
# 3. 메일 — 비밀번호 재설정과 아이디 찾기가 이 계정으로 나갑니다
# ══════════════════════════════════════════════════════════════════════════

# 비워 두면 메일을 실제로 보내지 않습니다.
#   개발  안 보내고 본문을 기록에 남깁니다. `banblit logs api` 로 링크를 볼 수 있습니다.
#   배포  안 보내고 못 보냈다는 것만 남깁니다. 비밀번호를 잊은 사람이 되찾을 길이
#         없어집니다. 그래도 서비스는 뜹니다.
#
# 지메일로 보내려면 이렇게 준비합니다.
#   1. 보낼 구글 계정에 2단계 인증을 켭니다.
#      https://myaccount.google.com/signinoptions/twosv
#   2. 앱 비밀번호를 만듭니다. 16자리가 한 번만 보입니다. 띄어쓰기는 빼고 붙여 씁니다.
#      https://myaccount.google.com/apppasswords
#   3. 그 16자리를 SMTP_PASSWORD 에 넣습니다. 구글 로그인 비밀번호가 아닙니다.
#
# 네이버라면 메일 환경설정에서 IMAP/SMTP 사용을 켜고
# SMTP_HOST=smtp.naver.com, SMTP_USER=아이디@naver.com 으로 적습니다.

#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=보내는-계정@gmail.com
#SMTP_PASSWORD=앱-비밀번호-16자리

# 받는 사람 메일함에 보이는 이름과 주소입니다.
#   MAIL_FROM=BANBLIT <보내는-계정@gmail.com>   → 메일함에 "BANBLIT" 으로 보입니다.
# 주소 부분은 위 SMTP_USER 와 같아야 합니다. 다른 주소를 적으면 지메일이 거절하거나
# 제 주소로 바꿔 버립니다. 다른 주소를 쓰려면 지메일에서 그 주소를 별칭으로
# 등록하고 인증까지 마쳐야 합니다.
# 비워 두면 SMTP_USER 를 그대로 씁니다.
#MAIL_FROM=BANBLIT <보내는-계정@gmail.com>


# ══════════════════════════════════════════════════════════════════════════
# 4. 그대로 둬도 되는 것들 — 필요할 때만 주석을 푸십시오
# ══════════════════════════════════════════════════════════════════════════

# 데이터베이스와 첨부파일을 떠 두는 서버 안 폴더, 그리고 주기와 보관 기간입니다.
# 컨테이너가 아니라 서버 폴더에 두는 것은, 컨테이너가 통째로 사라지는 것이
# 백업이 막아야 할 바로 그 상황이기 때문입니다.
# 6시간마다 뜨고 14일이 지난 것은 지웁니다.
#BACKUP_DIR=/srv/banblit/backups
#BACKUP_INTERVAL_HOURS=6
#BACKUP_KEEP_DAYS=14

# 자동 배정을 켤지와 몇 초마다 확인할지입니다.
# 배포는 기본이 켜짐(60초), 개발은 기본이 꺼짐입니다. 개발에서 눈으로 보려면
# 이 줄 대신 `banblit up --auto` 를 쓰십시오.
#AUTO_ASSIGN_ENABLED=true
#AUTO_ASSIGN_INTERVAL_SECONDS=60

# 게시판 첨부파일을 두는 컨테이너 안 경로입니다. 바꾸면 파일이 저장되는 자리와
# 서버가 읽는 자리가 함께 바뀝니다.
#ATTACHMENT_DIR=/var/lib/banblit/attachments

# 서버 안에서 화면이 도는 포트입니다. 바깥에는 열리지 않습니다.
# 서버에 직접 들어가 `curl localhost:8080` 으로 확인할 때만 씁니다.
#WEB_PORT=8080
