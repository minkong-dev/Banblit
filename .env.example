# 값의 앞, 뒤로 따옴표나 공백을 붙이지 않도록 주의해주세요.
# 잘못된 값이 입력될 경우 서버에 장애가 발생할 수 있습니다.

# env 파일을 수정한 뒤에는 반드시 재시작을 해주셔야 적용됩니다.
# 명령어는 다음과 같습니다.
# banblit up

# ══════════════════════════════════════════════════════════════════════════
# 1. 데이터베이스
# ══════════════════════════════════════════════════════════════════════════

# <작성> 데이터베이스에 접속할 계정의 이름을 작성해주세요.
POSTGRES_USER=banblit

# 데이터베이스 비밀번호를 작성해주세요.
# 개발서버의 경우 아래를 사용합니다.
# POSTGRES_PASSWORD=banblit-dev-password

# <작성> 배포 서버의 경우에만 아래 값을 변경해주세요.
# 위의 개발서버용 값을 사용할 경우 시스템 실행이 BLOCK 됩니다.
# 해당 값은 한번만 지정할 수 있습니다. 이후 수정이 불가능하니,
# 신중하게 지정해주시길 부탁드립니다.
POSTGRES_PASSWORD=banblit-dev-password

# <작성> 데이터베이스 이름을 작성해주세요.
POSTGRES_DB=banblit


# ══════════════════════════════════════════════════════════════════════════
# 2. 서비스 주소
# ══════════════════════════════════════════════════════════════════════════

# 사용자가 직접 접속할 도메인의 주소를 적어주세요.
# 접두사인 https:// 를 제외한 도메인 주소만 적어주시면 됩니다.

# 이 도메인 주소를 통해 SSL/TLS 인증서를 할당받습니다.
# 따라서 신중하고 정확하게 작성해주시길 부탁드립니다.
# 도메인 서비스를 사용한다면 DNS의 A 레코드를 사용해주세요.

# Cloudflare 를 쓴다면 이 레코드의 프록시를 꺼주세요.
# 프록시가 활성화 되어있을 경우, SSL 인증서 발급에 실패할 수 있습니다.
# 도메인 값을 누락하게되면 서버가 배포를 진행하지 않습니다.
# <작성> 배포시 아래 값의 주석을 해제해주세요.
# BANBLIT_DOMAIN=in-six-strings.banblit.com

# 비밀번호 재설정 메일 본문에 첨부할 재설정 링크의 공통 URL입니다.
# 비밀번호 재설정 링크가 해당 URL + 랜덤값을 조합해 고유 주소로 만들어져요.

# 위에 작성된 도메인에 https:// 를 붙여 적어주세요.
# 누락할 경우 링크가 localhost를 가리켜 링크가 동작하지 않습니다.

# <작성> 아래 값의 주석을 해제하고 작성해주세요.
# APP_ORIGIN=https://in-six-strings.banblit.com


# ══════════════════════════════════════════════════════════════════════════
# 3. 메일
# ══════════════════════════════════════════════════════════════════════════

# <작성> 재설정 링크를 담은 메일을 보내는 키를 작성해주세요.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=보내는계정@주소
# SMTP_PASSWORD=비밀번호는여기에작성해주세요

# <작성> 수신자에게 보이는 송신자명과 메일주소를 작성해주세요.
# MAIL_FROM=BANBLIT <보내는계정@주소>

# <> 안의 메일주소는 SMTP_USER 와 같아야 합니다.
# 다른 주소를 적으면 메일 송신이 불가능합니다.
# 기본값은 SMTP_USER 와 같으며,
# 송신자명을 변경하고 싶을 경우
# MAIL_FROM=BANBLIT <보내는-계정@gmail.com>
# 위와 같이 계정 앞에 사용할 송신자명을 작성합니다.


# ══════════════════════════════════════════════════════════════════════════
# 4. 운영 옵션
# ══════════════════════════════════════════════════════════════════════════

# <작성> 데이터베이스와 첨부파일을 백업하는 백업 폴더의 컨테이너 경로를 설정합니다.
# 백업 주기 및 보관 기간을 설정할 수 있습니다.

# 서버 디렉토리에 백업 디렉토리가 생성되며,
# 컨테이너 내 아래의 경로 디렉토리에 마운트됩니다.

# BACKUP_INTERVAL_HOURS 마다 백업하고,
# BACKUP_KEEP_DAYS 만큼 보관 후 소멸됩니다.

BACKUP_DIR=/srv/banblit/backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP_DAYS=14

# <작성> 스케줄링 엔진 배정을 제어하는 옵션입니다.
# 활성화시 AUTO_ASSIGN_INTERVAL_SECONDS 간격마다 서버 시각을 체크하고,
# 사용자가 지정한 스케줄링 엔진 연산시각을 넘긴 시점에 즉시 배정연산을 실행합니다.
# 비활성화시 엔진이 동작하지 않습니다.
AUTO_ASSIGN_ENABLED=true
AUTO_ASSIGN_INTERVAL_SECONDS=600

# 컨테이너 내 팀별 게시판 및 공지사항에 첨부된 파일을 보관하는 경로입니다.
ATTACHMENT_DIR=/var/lib/banblit/attachments

# Caddy나 DNS에 문제가 생길 경우, 사용자는 서버에 도달할 방법이 없습니다.
# 따라서 운영 담당자께서는 Nginx의 80번 포트를 통해 직접 연결을 시도해주시면 됩니다.
# 아래 WEB_PORT 값은 해당 Nginx 80번 포트와 매핑될 포트를 작성해주시면 됩니다.
# 서버의 컨테이너 외부에서 헬스체크가 가능하도록 설정하는 옵션이며,
# curl localhost:8080/api/health 를 통해 헬스체크를 진행할 수 있습니다.
WEB_PORT=8080

# 서버 시간의 기준을 지정합니다.
# 기본값은 서울입니다.
TZ=Asia/Seoul