# 앞단. 인증서를 스스로 받고 갱신하며, http 로 온 요청을 https 로 돌린다.
# 이것이 필요한 이유는 배포 설정이 로그인 쿠키에 Secure 를 붙이기 때문이다 —
# http 로 띄우면 브라우저가 쿠키를 아예 저장하지 않아 로그인이 성립하지 않는다.
#
# 주소는 코드에 박지 않는다. .env 의 BANBLIT_DOMAIN 이 정본이다.

{$BANBLIT_DOMAIN} {
	encode zstd gzip

	# 화면과 /api 는 web(nginx) 이 이미 가른다. 여기서는 통째로 넘긴다.
	reverse_proxy web:80

	# 어느 주소가 몇 번 왔는지만 남긴다. 본문은 남기지 않는다 —
	# 로그인 요청 본문에는 비밀번호가, 재설정 요청에는 토큰이 들어 있다.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	header {
		# 브라우저가 다음부터 http 로 먼저 두드리지 않게 한다.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
