# reverse proxy 입니다. 인증서를 자동으로 받고 갱신하며, http 요청을 https 로 전환합니다.
# 배포는 로그인 cookie 에 Secure 가 붙으므로 https 가 아니면 로그인이 되지 않습니다.
# 도메인은 .env 의 BANBLIT_DOMAIN 에 작성되어 있는 값을 기준으로 합니다.

{$BANBLIT_DOMAIN} {
	encode zstd gzip

	# 화면과 /api 의 분기는 web(nginx) 이 합니다. 여기서는 전부 web 으로 전달합니다.
	reverse_proxy web:80

	# 접속 기록만 남깁니다. 요청 본문은 남기지 않습니다(비밀번호·재설정 token 포함).
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	header {
		# 브라우저가 이후 요청을 https 로만 보내게 합니다.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
