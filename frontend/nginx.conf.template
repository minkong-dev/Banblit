# 배포용 nginx 설정입니다. 화면 경로를 직접 요청해도 index.html 을 반환하고, /api 요청만 api 로 전달합니다.
# ${API_ORIGIN} 은 container 시작 시 nginx 공식 Docker image 의 envsubst 가 치환합니다. templates/ 폴더의 파일만 치환 대상입니다.

server {
  listen 80;
  server_name _;

  # build 결과 파일은 이름에 content hash 가 포함되므로 1년 동안 cache 합니다.
  location /assets/ {
    root /usr/share/nginx/html;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # 존재하지 않는 이미지는 404 를 반환합니다. index.html 로 대체하면 링크 미리보기 수집기가 HTML 을 이미지로 저장합니다.
  location /images/ {
    root /usr/share/nginx/html;
    try_files $uri =404;
  }

  # 존재하지 않는 경로는 index.html 을 반환합니다. 이 설정이 없을 경우 /scheduler 를 직접 요청하면 404 가 발생합니다.
  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /index.html;
  }

  # 127.0.0.11 은 docker 내부 DNS resolver 입니다. proxy_pass 에 변수를 쓰면 nginx 가 요청마다 주소를 다시 조회하므로,
  # api container 를 다시 생성해도 502 가 발생하지 않습니다.
  resolver 127.0.0.11 valid=10s;

  location /api/ {
    # set 은 rewrite 의 break 뒤에서 실행되지 않으므로 rewrite 보다 위에 둡니다.
    set $api_origin ${API_ORIGIN};

    # /api 접두사를 삭제하고 전달합니다. api 의 endpoint 는 /periods 처럼 /api 접두사를 포함하지 않습니다.
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_origin;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 첨부파일 1개의 크기 상한입니다. 화면의 MAX_ATTACHMENT_BYTES(frontend/src/lib/boards.ts)와 같은 값이어야 합니다.
    client_max_body_size 300m;

    # 배정 계산은 조율안까지 포함하면 30초 이내에 응답합니다. 변경할 경우 화면의 timeout 과 함께 변경합니다.
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
  }
}
