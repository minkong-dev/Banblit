# 배포에서 개발 서버가 하던 두 가지를 대신한다.
#   (1) 주소창에 /scheduler 를 직접 쳐도 index.html 을 돌려준다
#   (2) /api 로 오는 것만 스케줄링 API 로 넘긴다

server {
  listen 80;
  server_name _;

  # 묶인 파일은 이름에 내용 해시가 붙어 있어 오래 물려도 안전하다.
  location /assets/ {
    root /usr/share/nginx/html;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # 화면은 주소가 여럿이지만 파일은 index.html 하나다. 없는 경로는 그것으로 떨어뜨린다.
  # 이게 없으면 /scheduler 를 직접 치거나 새로 고칠 때 404 가 난다.
  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /index.html;
  }

  # ${API_ORIGIN} 은 컨테이너가 뜰 때 채워진다. nginx 공식 이미지가 templates/ 안의
  # 파일만 그렇게 다루므로 이 파일은 그 폴더로 들어간다.
  location /api/ {
    # 접두사를 떼고 넘긴다 — 서버는 /periods 로 알고 있고 /api/periods 를 모른다.
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass ${API_ORIGIN};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 배정 계산은 조율안까지 가면 22초가 걸린 실측이 있다. 기본값(60초)에 맡기지
    # 않고 명시한다. 이 값을 넘기면 화면이 먼저 끊는 8초와 함께 다시 정해야 한다.
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
  }
}
