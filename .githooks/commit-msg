#!/usr/bin/env sh
# 커밋 메시지 형식을 검사합니다(CLAUDE.md 7장).
#
#   <scope>: <imperative summary>
#
#   <optional body>
#
# 활성화: git config core.hooksPath .githooks   (banblit up 이 자동으로 실행합니다)

set -u

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    echo "커밋 거부: 메시지 파일이 존재하지 않습니다." >&2
    exit 1
fi

# 허용 scope 목록입니다. 새 scope 는 여기에 추가합니다.
SCOPES="scheduling docs infra backend frontend test chore"

# git 이 추가하는 주석 줄과 앞쪽 빈 줄은 검사 대상이 아닙니다.
CLEANED=$(sed '/^#/d' "$MSG_FILE" | sed '/./,$!d')

SUBJECT=$(printf '%s\n' "$CLEANED" | sed -n '1p')
SECOND=$(printf '%s\n' "$CLEANED" | sed -n '2p')
LINES=$(printf '%s\n' "$CLEANED" | sed -n '$=')

reject() {
    echo "" >&2
    echo "커밋이 거부되었습니다 — $1" >&2
    echo "" >&2
    echo "  입력한 첫 줄: ${SUBJECT:-(비어 있음)}" >&2
    echo "" >&2
    echo "  올바른 형식:" >&2
    echo "    <scope>: <요약>" >&2
    echo "" >&2
    echo "    <본문은 빈 줄 1개 뒤에 작성합니다>" >&2
    echo "" >&2
    echo "  허용 scope: $SCOPES" >&2
    echo "  예시: scheduling: add room-specific operating hours" >&2
    echo "" >&2
    exit 1
}

if [ -z "$SUBJECT" ]; then
    reject "메시지가 비어 있습니다."
fi

# Merge 커밋과 Revert 커밋은 git 이 생성하는 형식이므로 통과합니다.
case "$SUBJECT" in
    "Merge "*|"Revert "*)
        exit 0
        ;;
esac

# 첫 줄은 허용 scope, 콜론, 공백 1개, 비어 있지 않은 요약 순서입니다.
PATTERN="^($(echo "$SCOPES" | tr ' ' '|')): [^[:space:]].*$"
if ! printf '%s' "$SUBJECT" | grep -Eq "$PATTERN"; then
    reject "첫 줄이 '<scope>: <요약>' 형식이 아니거나, 허용되지 않은 scope 입니다."
fi

# 본문이 있을 경우 첫 줄과 본문 사이에 빈 줄 1개가 있어야 합니다.
if [ "${LINES:-1}" -gt 1 ] && [ -n "$SECOND" ]; then
    reject "첫 줄과 본문 사이에 빈 줄이 존재하지 않습니다."
fi

exit 0
