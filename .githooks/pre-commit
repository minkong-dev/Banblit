#!/usr/bin/env sh
# 커밋 직전에 .cluedoc/graph 가 소스와 같은지 확인하고, 서버 테스트와 타입 검사(banblit.sh check)를 실행합니다. 실패하면 커밋을 거부합니다.
# 개발 PC(윈도우)에서만 실행합니다. 배포 서버의 Docker image 에는 테스트 도구가 존재하지 않습니다.
# 건너뛰려면 git commit --no-verify 를 씁니다. 활성화는 banblit up 이 합니다(core.hooksPath).

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) ;;
    *) exit 0 ;;
esac

ROOT="$(git rev-parse --show-toplevel)"

# 코드 관계 노트(.cluedoc/graph/)가 소스와 같은지 확인하고, 같으면 stage 합니다. 다르면 커밋을 거부합니다.
# 재생성은 .claude/hooks/codegraph_hook.py 가 합니다. 호스트에 Python 이 없으면 container 에서 실행합니다.
if command -v python >/dev/null 2>&1; then
    python -I "$ROOT/scripts/codegraph.py" --check
else
    docker compose run --rm --no-deps -T dev python scripts/codegraph.py --check
fi || {
    echo "커밋이 거부되었습니다 — .cluedoc/graph 가 소스와 다릅니다. python scripts/codegraph.py 를 실행한 뒤 다시 커밋하십시오." >&2
    exit 1
}
git -C "$ROOT" add .cluedoc/graph

if ! "$ROOT/banblit.sh" check; then
    echo "" >&2
    echo "커밋이 거부되었습니다 — 테스트 또는 타입 검사에 실패했습니다. .logs/ 의 기록을 확인하십시오." >&2
    exit 1
fi
